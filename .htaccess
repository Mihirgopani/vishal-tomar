<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.json|artisan|phpunit\.xml) - [F,L,NC]

    # Forward all requests into the /public directory transparently
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

